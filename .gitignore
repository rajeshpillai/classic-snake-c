# Build artifacts
*.o
snake

# Tutorial binaries -- every lessons/*/ dir builds a binary beside its source
tutorial/lessons/*/*
!tutorial/lessons/*/*.c
!tutorial/lessons/*/*.md

# High score file, if it ever lands here (no $HOME)
.snake_highscore

# Generated wasm bundle. Built by `make web`, published to the gh-pages
# branch by ./gh-deploy.sh -- not carried in main's history.
docs/

# Sanitizer / debug leftovers
*.dSYM/
core
vgcore.*
